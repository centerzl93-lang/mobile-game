{
  "name": "little-village",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Little Village \u2014 an original survival village-builder, installable on iPhone as a PWA.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "playwright test",
    "test:fast": "playwright test --grep-invert @slow --reporter=dot",
    "test:slow": "playwright test --grep @slow",
    "test:sim": "tsx --test sim-tests/*.test.ts",
    "parity:export": "tsx tools/parity/export-fixtures.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vite-plugin-pwa": "^0.20.5"
  },
  "dependencies": {
    "@types/three": "^0.185.1",
    "three": "^0.185.1"
  }
}
